# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Set to your Vercel deployment URL after frontend deploy
FRONTEND_URL=https://your-app.vercel.app
CORS_ORIGIN=https://your-app.vercel.app

NODE_ENV=production

# These are auto-provisioned by Railway — do not set manually:
# DATABASE_URL (from Railway Postgres plugin)
# REDIS_HOST, REDIS_PORT (from Railway Redis plugin)

# Optional: SMTP for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
